// Single-decree Paxos (the "Synod" protocol).
//
// Every node plays all three roles: proposer, acceptor, and learner.
// Nodes never touch a network directly; handling a message (or a timer
// firing) appends outgoing messages to the node's {outbox}, which the
// environment (e.g. a simulator) drains and delivers however it likes.
//
// Values are positive integers; 0 means "no value".
// Ballots are positive integers, unique per proposer: ballot = round * N + id.
// Ballot 0 means "no ballot".

// The message kinds exchanged between nodes.
type Msg {
	// Phase 1a: proposer asks acceptors to promise not to accept ballots < {ballot}.
	case Prepare(ballot: int);
	// Phase 1b: acceptor promises, reporting the last ballot/value it accepted (if any).
	case Promise(ballot: int, acceptedBallot: int, acceptedValue: int);
	// Phase 2a: proposer asks acceptors to accept {value} in {ballot}.
	case Accept(ballot: int, value: int);
	// Phase 2b: acceptor accepted {value} in {ballot}; broadcast to all learners.
	case Accepted(ballot: int, value: int);
	// Acceptor rejects a Prepare or Accept for {ballot}, having promised {promised}.
	case Nack(ballot: int, promised: int);
	// A node that does not know the outcome asks others for it.
	case Query;
	// A learner that knows the chosen value tells another node.
	case Decided(value: int);

	def render(buf: StringBuilder) -> StringBuilder {
		match (this) {
			Prepare(b) => buf.put1("Prepare(b=%d)", b);
			Promise(b, ab, av) => buf.put3("Promise(b=%d, ab=%d, av=%d)", b, ab, av);
			Accept(b, v) => buf.put2("Accept(b=%d, v=%d)", b, v);
			Accepted(b, v) => buf.put2("Accepted(b=%d, v=%d)", b, v);
			Nack(b, p) => buf.put2("Nack(b=%d, promised=%d)", b, p);
			Query => buf.puts("Query");
			Decided(v) => buf.put1("Decided(v=%d)", v);
		}
		return buf;
	}
}

// An outgoing message, addressed to node {dst}.
type Outgoing(dst: int, msg: Msg) #unboxed { }

// Callbacks that let an environment observe protocol-level events (e.g. for checking).
class PaxosObserver {
	def onAccepted(node: int, ballot: int, value: int) { }
	def onLearned(node: int, value: int) { }
}

// Configuration knobs; the defaults are the correct protocol.
// Turning them off injects bugs, which is useful for testing the fuzzer.
class PaxosConfig {
	var persistAcceptor = true;	// acceptor state survives crashes
	var persistRound = true;	// proposer's ballot round survives crashes
	var adoptAccepted = true;	// proposer adopts highest accepted value from promises
}

// State that survives a crash (i.e. lives on simulated stable storage).
class PaxosStable {
	var promised: int;		// acceptor: highest ballot promised
	var acceptedBallot: int;	// acceptor: ballot of last accepted value
	var acceptedValue: int;		// acceptor: last accepted value
	var round: int;			// proposer: last ballot round used
}

private enum Phase { IDLE, PREPARE, ACCEPT }

class PaxosNode(id: int, n: int, config: PaxosConfig, observer: PaxosObserver) {
	def outbox = Vector<Outgoing>.new();
	var stable = PaxosStable.new();

	// Proposer state (volatile).
	var proposal: int;		// value this node wants chosen, 0 if none
	private var phase: Phase;
	private var ballot: int;	// current ballot, if not IDLE
	private var maxSeen: int;	// highest ballot seen in any message
	private var promises: Array<bool>;
	private var numPromises: int;
	private var bestBallot: int;	// highest accepted ballot reported in promises
	private var bestValue: int;

	// Learner state (volatile).
	var decided: int;			// learned value, 0 if unknown
	private var learnBallot: Array<int>;	// per acceptor: highest Accepted ballot seen
	private var learnValue: Array<int>;	// per acceptor: value of that ballot

	new() {
		reset();
	}

	def majority() -> int {
		return n / 2 + 1;
	}
	// Discards all volatile state, as if the node had crashed and restarted.
	def crashAndRestart() {
		var s = stable;
		stable = PaxosStable.new();
		if (config.persistAcceptor) {
			stable.promised = s.promised;
			stable.acceptedBallot = s.acceptedBallot;
			stable.acceptedValue = s.acceptedValue;
		}
		if (config.persistRound) stable.round = s.round;
		outbox.clear();
		reset();
	}
	private def reset() {
		phase = Phase.IDLE;
		ballot = 0;
		maxSeen = 0;
		promises = Array<bool>.new(n);
		numPromises = 0;
		bestBallot = 0;
		bestValue = 0;
		decided = 0;
		learnBallot = Array<int>.new(n);
		learnValue = Array<int>.new(n);
	}
	// Sets the value this node will propose on its next ballot.
	def propose(value: int) {
		proposal = value;
	}
	// Called by the environment when this node's retry timer fires.
	// Starts a new ballot if this node has a proposal, or asks for the outcome otherwise.
	def onTimeout() {
		if (decided != 0) return;
		if (proposal == 0) {
			broadcast(Msg.Query);
			return;
		}
		var r = stable.round + 1, seenRound = maxSeen / n + 1;
		if (seenRound > r) r = seenRound;
		stable.round = r;
		ballot = r * n + id;
		phase = Phase.PREPARE;
		for (i < n) promises[i] = false;
		numPromises = 0;
		bestBallot = 0;
		bestValue = 0;
		broadcast(Msg.Prepare(ballot));
	}
	// Handles a message from node {src}.
	def receive(src: int, msg: Msg) {
		match (msg) {
			Prepare(b) => {
				see(b);
				if (decided != 0) {
					send(src, Msg.Decided(decided));
					return;
				}
				var s = stable;
				if (b >= s.promised) {
					s.promised = b;
					send(src, Msg.Promise(b, s.acceptedBallot, s.acceptedValue));
				} else {
					send(src, Msg.Nack(b, s.promised));
				}
			}
			Promise(b, ab, av) => {
				if (phase != Phase.PREPARE || b != ballot || promises[src]) return;
				promises[src] = true;
				numPromises++;
				if (ab > bestBallot) {
					bestBallot = ab;
					bestValue = av;
				}
				if (numPromises >= majority()) {
					phase = Phase.ACCEPT;
					var v = if(bestBallot > 0 && config.adoptAccepted, bestValue, proposal);
					broadcast(Msg.Accept(ballot, v));
				}
			}
			Accept(b, v) => {
				see(b);
				var s = stable;
				if (b >= s.promised) {
					s.promised = b;
					s.acceptedBallot = b;
					s.acceptedValue = v;
					observer.onAccepted(id, b, v);
					broadcast(Msg.Accepted(b, v));
				} else {
					send(src, Msg.Nack(b, s.promised));
				}
			}
			Accepted(b, v) => {
				see(b);
				if (b <= learnBallot[src]) return;
				learnBallot[src] = b;
				learnValue[src] = v;
				var count = 0;
				for (i < n) if (learnBallot[i] == b) count++;
				if (count >= majority()) learn(v);
			}
			Nack(b, p) => {
				see(p);
				if (b == ballot) phase = Phase.IDLE; // give up; retry on next timeout
			}
			Query => {
				if (decided != 0) send(src, Msg.Decided(decided));
			}
			Decided(v) => learn(v);
		}
	}
	private def learn(v: int) {
		if (decided == v) return;
		decided = v; // a conflicting re-learn is reported to the observer, not hidden
		phase = Phase.IDLE;
		observer.onLearned(id, v);
	}
	private def see(b: int) {
		if (b > maxSeen) maxSeen = b;
	}
	private def send(dst: int, msg: Msg) {
		outbox.put(Outgoing(dst, msg));
	}
	private def broadcast(msg: Msg) {
		for (i < n) send(i, msg);
	}
}
