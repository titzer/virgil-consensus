// Shared command-line driver for each protocol's test program.
//
// Usage: <protocol> scenarios [-v | -trace | -play] [name-filter]
//        <protocol> fuzz [-seed=N] [-runs=N] [-chaos=N] [-bound=N] [-v | -trace | -play]
//        <protocol> selftest [-runs=N]
//
// -play makes the simulation interactive (see core/Play.v3); use it via play.sh.
//
// Each protocol provides a {Suite} with its scenarios and a fuzzer for a single
// run. Fuzz run i uses seed (N + i); a failing run is reproduced with
// -seed=<its seed> -runs=1.
//
// Fault injection: each suite also lists {Injection}s, deliberate protocol
// mistakes that can be switched on with -inject=NAME, to check that the
// checkers actually catch them. {selftest} runs every injection's scenarios
// and fuzzes with each one until it is detected.

// Command-line options, shared by scenarios and fuzzing.
class TestOptions {
	var verbose = false;	// print a message sequence diagram
	var trace = false;	// print a raw event log
	var seed = 1;
	var runs = 1000;
	var chaos = 400;	// max rounds of the chaos phase
	var bound = 3000;	// liveness bound: rounds after stabilization
	var inject: string;	// name of an injected protocol fault (see {Injection}), or null
	var filter: string;	// scenario name filter
	var play = false;	// interactive: ask the user before each simulation event
	var ansi = true;	// in play mode, erase menus with ANSI escape codes
	var runsGiven = false;

	// Creates a listener for a simulation, according to the options.
	def listener<M>() -> SimListener<M> {
		if (trace) return TextLog<M>.new();
		if (verbose) return Diagram<M>.new();
		return SimListener<M>.new();
	}
	// Creates a controller for a simulation: an interactive player, or null.
	def controller<M>() -> SimController<M> {
		return if(play, Player<M>.new(ansi));
	}
	// Returns true if the named protocol fault is injected.
	def injected(name: string) -> bool {
		return inject != null && Strings.equal(inject, name);
	}
}

// A named scenario; returns null on success, or an error message.
type Scenario(name: string, run: TestOptions -> string) #unboxed { }

// The result of one fuzz run.
class RunResult(error: string, isSafety: bool, config: string, rounds: int, delivered: int) { }

// A protocol's test suite.
class Suite(name: string) {
	def scenarios() -> Array<Scenario>;
	def fuzzOne(seed: int, opts: TestOptions) -> RunResult;
	def injections() -> Array<Injection> {
		return [];
	}
}

// A deliberately injected protocol fault, for testing the checkers. {checks}
// are scenarios that inject it themselves and pass only if the checker
// detects the resulting violation.
type Injection(name: string, description: string, checks: Array<Scenario>) #unboxed { }

component Driver {
	def run(suite: Suite, args: Array<string>) -> int {
		if (args.length == 0) return usage(suite, null);
		var opts = TestOptions.new();
		for (i = 1; i < args.length; i++) {
			var a = args[i];
			if (Strings.equal(a, "-v")) opts.verbose = true;
			else if (Strings.equal(a, "-trace")) opts.trace = opts.verbose = true;
			else if (Strings.equal(a, "-play")) opts.play = opts.verbose = true;
			else if (Strings.equal(a, "-plain")) opts.ansi = false;
			else if (Strings.startsWith(a, "-seed=")) opts.seed = intArg(a, 6);
			else if (Strings.startsWith(a, "-runs=")) { opts.runs = intArg(a, 6); opts.runsGiven = true; }
			else if (Strings.startsWith(a, "-chaos=")) opts.chaos = intArg(a, 7);
			else if (Strings.startsWith(a, "-bound=")) opts.bound = intArg(a, 7);
			else if (Strings.startsWith(a, "-inject=")) opts.inject = Arrays.range(a, 8, a.length);
			else if (a.length > 0 && a[0] == '-') return usage(suite, a);
			else opts.filter = a;
		}
		if (opts.play && !opts.runsGiven) opts.runs = 1;	// play one fuzz run unless told otherwise
		if (opts.inject != null) {
			var found = false;
			for (j in suite.injections()) if (Strings.equal(j.name, opts.inject)) found = true;
			if (!found) return usage(suite, opts.inject);
		}
		var cmd = args[0];
		if (Strings.equal(cmd, "scenarios")) return runScenarios(suite, opts);
		if (Strings.equal(cmd, "fuzz")) return runFuzz(suite, opts);
		if (Strings.equal(cmd, "selftest")) return runSelftest(suite, opts);
		return usage(suite, cmd);
	}
	def runScenarios(suite: Suite, opts: TestOptions) -> int {
		var failures = 0, count = 0;
		for (s in suite.scenarios()) {
			if (opts.filter != null && !contains(s.name, opts.filter)) continue;
			count++;
			if (!runScenario("scenario: ", s, opts)) failures++;
		}
		if (count == 0) System.puts("no scenarios matched\n");
		else System.puts(if(failures == 0, "all scenarios passed\n", "SOME SCENARIOS FAILED\n"));
		return if(failures > 0 || count == 0, 1, 0);
	}
	private def runScenario(prefix: string, s: Scenario, opts: TestOptions) -> bool {
		System.puts(prefix);
		System.puts(s.name);
		System.puts(if(opts.verbose, "\n", " ... "));
		var err = s.run(opts);
		if (err == null) {
			System.puts("PASS\n");
			return true;
		}
		System.puts("FAIL: ");
		System.puts(err);
		System.ln();
		return false;
	}
	// For each injected fault: runs its scenarios (which must detect it), then
	// fuzzes with it injected until the checker catches it, up to -runs runs.
	def runSelftest(suite: Suite, opts: TestOptions) -> int {
		var failures = 0;
		var runs = if(opts.runsGiven, opts.runs, 20000);
		for (j in suite.injections()) {
			if (opts.filter != null && !contains(j.name, opts.filter)) continue;
			System.puts(StringBuilder.new().put2("-inject=%s: %s\n", j.name, j.description).toString());
			for (s in j.checks) if (!runScenario("  scenario: ", s, opts)) failures++;
			// Fuzz quietly, even if -v asked for diagrams of the scenarios.
			var verbose = opts.verbose, trace = opts.trace, play = opts.play;
			opts.verbose = opts.trace = opts.play = false;
			opts.inject = j.name;
			var caught = false;
			for (i < runs) {
				var r = suite.fuzzOne(opts.seed + i, opts);
				if (r.error == null) continue;
				System.puts(StringBuilder.new()
					.put3("  fuzz: caught after %d runs (seed=%d): %s\n", i + 1, opts.seed + i, r.error)
					.toString());
				caught = true;
				break;
			}
			if (!caught) System.puts(StringBuilder.new().put1("  fuzz: not caught in %d runs (it may be rare; try a larger -runs)\n", runs).toString());
			opts.inject = null;
			opts.verbose = verbose;
			opts.trace = trace;
			opts.play = play;
		}
		System.puts(if(failures == 0, "selftest passed\n", "SELFTEST FAILED\n"));
		return if(failures > 0, 1, 0);
	}
	def runFuzz(suite: Suite, opts: TestOptions) -> int {
		var safety = 0, liveness = 0, completed = 0, totalRounds = 0L, totalMsgs = 0L;
		for (i < opts.runs) {
			var s = opts.seed + i;
			var r = suite.fuzzOne(s, opts);
			completed++;
			totalRounds += r.rounds;
			totalMsgs += r.delivered;
			if (r.error == null) continue;
			if (r.isSafety) safety++;
			else liveness++;
			System.puts(StringBuilder.new()
				.put3("FAIL seed=%d: %s\n  config: %s\n", s, r.error, r.config)
				.put2("  reproduce: %s fuzz -seed=%d -runs=1 -v", suite.name, s)
				.puts(if(opts.inject != null, " -inject=", "")).puts(if(opts.inject != null, opts.inject, ""))
				.ln().toString());
			if (safety + liveness >= 10) {
				System.puts("stopping after 10 failures\n");
				break;
			}
		}
		System.puts(StringBuilder.new()
			.put3("%d runs, %d safety violations, %d liveness failures", completed, safety, liveness)
			.put2(" (%d rounds, %d messages delivered)", totalRounds, totalMsgs)
			.ln().toString());
		return if(safety + liveness > 0, 1, 0);
	}
	def usage(suite: Suite, arg: string) -> int {
		var buf = StringBuilder.new();
		if (arg != null) buf.put1("unknown argument: %s\n", arg);
		buf.put1("Usage: %s scenarios [-v | -trace | -play] [name-filter]\n", suite.name);
		buf.put1("       %s fuzz [-seed=N] [-runs=N] [-chaos=N] [-bound=N] [-v | -trace | -play]\n", suite.name);
		buf.puts("  -v      print a message sequence diagram\n");
		buf.puts("  -trace  print a raw event log\n");
		buf.puts("  -play   interactive: choose each event (run via play.sh for single-key input)\n");
		var injections = suite.injections();
		if (injections.length > 0) {
			buf.puts("\nFault injection, for checking that the checkers catch protocol mistakes:\n");
			buf.put1("       %s selftest [-runs=N]          run every injection's checks\n", suite.name);
			buf.puts("  -inject=NAME (with scenarios, fuzz, or -play) injects one of:\n");
			for (j in injections) buf.put2("    %s: %s\n", j.name, j.description);
		}
		System.puts(buf.toString());
		return 2;
	}
	def intArg(a: string, start: int) -> int {
		var r = Ints.parseDecimal(a, start);
		if (r.0 <= 0 || start + r.0 != a.length) {
			System.error("ArgError", StringBuilder.new().put1("invalid number in %s", a).toString());
		}
		return r.1;
	}
	def contains(s: string, sub: string) -> bool {
		for (i = 0; i + sub.length <= s.length; i++) {
			if (Strings.equal(Arrays.range(s, i, i + sub.length), sub)) return true;
		}
		return false;
	}
}
