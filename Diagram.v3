// Prints a simulation as an ASCII message sequence diagram, in the style of
// the Wikipedia article on Paxos. Each node has a vertical lifeline; each
// line of output is one event. Deliveries in the same batch of the same
// message are grouped into one line, e.g. a broadcast:
//
//   round  N0    N1    N2
//       1   X---->|---->|      Prepare(b=3)
//           |<----X-----X      Promise(b=3, ab=0, av=0)
//
// Legend:  X sender   > < receiver   x lost   ! crash   + restart   # learn
class Diagram extends SimListener {
	def W = 6;		// column width per node
	def PREFIX = 7;		// width of the round number column
	var started = false;
	var lastRound = -1;
	var pending = Vector<(Packet, bool)>.new();	// buffered (packet, lost) events

	def onTimeout(sim: Sim, node: int) {
		var what = if(sim.nodes[node].proposal != 0, "timeout: starts a ballot", "timeout: queries for outcome");
		mark(sim, node, 'o', StringBuilder.new().put1("N%d ", node).puts(what));
	}
	def onCrash(sim: Sim, node: int) {
		mark(sim, node, '!', StringBuilder.new().put1("N%d CRASHES", node));
	}
	def onRestart(sim: Sim, node: int) {
		mark(sim, node, '+', StringBuilder.new().put1("N%d restarts (volatile state lost)", node));
	}
	def onDeliver(sim: Sim, p: Packet) {
		pending.put((p, false));
	}
	def onDrop(sim: Sim, p: Packet) {
		pending.put((p, true));
	}
	def onChosen(sim: Sim, value: int, ballot: int) {
		flush(sim);
		emit(sim, lifelines(sim), StringBuilder.new().put2("*** value %d is chosen (ballot %d) ***", value, ballot));
	}
	def onLearned(sim: Sim, node: int, value: int) {
		mark(sim, node, '#', StringBuilder.new().put2("N%d learns %d", node, value));
	}
	def onViolation(sim: Sim, msg: string) {
		flush(sim);
		emit(sim, lifelines(sim), StringBuilder.new().puts("!!! SAFETY VIOLATION: ").puts(msg));
	}
	def onNote(sim: Sim, msg: string) {
		flush(sim);
		emit(sim, lifelines(sim), StringBuilder.new().puts("--- ").puts(msg).puts(" ---"));
	}
	def onQuiet(sim: Sim) {
		flush(sim);
	}

	// Prints a single-node event, marking the node's lifeline with {ch}.
	private def mark(sim: Sim, node: int, ch: byte, note: StringBuilder) {
		flush(sim);
		var line = lifelines(sim);
		line[center(node)] = ch;
		emit(sim, line, note);
	}
	// Prints all buffered deliveries, grouping identical messages.
	private def flush(sim: Sim) {
		if (pending.length == 0) return;
		var groups = Vector<Group>.new();
		// Group by (src, msg): one sender's broadcast becomes one group.
		for (i < pending.length) {
			var e = pending[i], p = e.0;
			var g: Group;
			for (j < groups.length) {
				var h = groups[j];
				if (h.srcs[p.src] && h.msg == p.msg) { g = h; break; }
			}
			if (g == null) {
				groups.put(g = Group.new(p.msg, Array<bool>.new(sim.n), Array<int>.new(sim.n)));
				g.srcs[p.src] = true;
			}
			g.dsts[p.dst] = if(e.1, LOST, RECEIVED);
		}
		pending.clear();
		// Merge groups that sent the same message to the same destinations,
		// e.g. several acceptors' Promises to one proposer.
		var merged = Vector<Group>.new();
		for (i < groups.length) {
			var g = groups[i], into: Group;
			for (j < merged.length) {
				var h = merged[j];
				if (h.msg == g.msg && sameDsts(h, g) && separable(h, g)) { into = h; break; }
			}
			if (into == null) {
				merged.put(g);
			} else {
				for (k < sim.n) {
					if (g.srcs[k]) into.srcs[k] = true;
					if (g.dsts[k] != NONE) into.dsts[k] = g.dsts[k];
				}
			}
		}
		for (i < merged.length) draw(sim, merged[i]);
	}
	// Two groups have the same destinations, ignoring each sender's message to itself.
	private def sameDsts(a: Group, b: Group) -> bool {
		for (k < a.dsts.length) {
			if (a.srcs[k] || b.srcs[k]) continue;
			if (a.dsts[k] != b.dsts[k]) return false;
		}
		return true;
	}
	// Merging is only drawn sensibly if all receivers lie on one side of all senders.
	private def separable(a: Group, b: Group) -> bool {
		var minS = a.srcs.length, maxS = -1;
		for (k < a.srcs.length) {
			if (a.srcs[k] || b.srcs[k]) {
				if (k < minS) minS = k;
				if (k > maxS) maxS = k;
			}
		}
		for (k < a.dsts.length) {
			if (a.srcs[k] || b.srcs[k]) continue;
			if (a.dsts[k] == NONE && b.dsts[k] == NONE) continue;
			if (k > minS && k < maxS) return false;
		}
		return true;
	}
	private def draw(sim: Sim, g: Group) {
		var n = sim.n, line = lifelines(sim);
		// Many senders replying to one of themselves (e.g. Promises to a proposer):
		// draw that node as the receiver, so the replies point at it.
		var numSrcs = 0, others = false, self = -1;
		for (k < n) {
			if (g.srcs[k]) {
				numSrcs++;
				if (g.dsts[k] != NONE) self = k;
			} else if (g.dsts[k] != NONE) {
				others = true;
			}
		}
		if (numSrcs > 1 && !others && self >= 0) g.srcs[self] = false;
		var lo = n, hi = -1, onlySelf = true;
		for (k < n) {
			if (g.srcs[k] || g.dsts[k] != NONE) {
				if (k < lo) lo = k;
				if (k > hi) hi = k;
			}
			if (g.dsts[k] != NONE && !g.srcs[k]) onlySelf = false;
		}
		for (x = center(lo); x < center(hi); x++) line[x] = '-';
		var minS = n, maxS = -1;
		for (k < n) {
			if (g.srcs[k]) {
				if (k < minS) minS = k;
				if (k > maxS) maxS = k;
			}
		}
		var lost = StringBuilder.new();
		for (k < n) {
			var c = center(k);
			if (g.srcs[k]) {
				line[c] = 'X';
			} else if (g.dsts[k] != NONE) {
				line[c] = if(g.dsts[k] == LOST, 'x', '|');
				if (k > maxS) line[c - 1] = '>';
				if (k < minS) line[c + 1] = '<';
			}
			if (g.dsts[k] == LOST) lost.put1(" N%d", k);
		}
		var note = g.msg.render(StringBuilder.new());
		if (onlySelf) note.puts("  (to self)");
		if (lost.length > 0) note.puts("  lost:").puts(lost.toString());
		emit(sim, line, note);
	}
	// A blank line with each node's lifeline: '|' if up, ':' if down.
	private def lifelines(sim: Sim) -> Array<byte> {
		var line = Array<byte>.new(sim.n * W);
		for (i < line.length) line[i] = ' ';
		for (k < sim.n) line[center(k)] = if(sim.up[k], '|', ':');
		return line;
	}
	private def center(node: int) -> int {
		return node * W + W / 2;
	}
	private def emit(sim: Sim, line: Array<byte>, note: StringBuilder) {
		var buf = StringBuilder.new();
		if (!started) {
			started = true;
			buf.puts("round ");
			for (k < sim.n) buf.pad(' ', PREFIX + center(k) - 1).put1("N%d", k);
			buf.ln().puts("legend: X sender, > < receiver, x lost, o timeout, ! crash, + restart, # learn").ln();
		}
		var start = buf.length;
		if (sim.round != lastRound) {
			lastRound = sim.round;
			buf.putd(sim.round);
		}
		buf.pad(' ', start + PREFIX);
		for (b in line) buf.putc(b);
		buf.puts("  ").puts(note.toString()).ln();
		System.puts(buf.toString());
	}
}

def NONE = 0;
def RECEIVED = 1;
def LOST = 2;

private class Group(msg: Msg, srcs: Array<bool>, dsts: Array<int>) { }
