// Randomized fuzzer for Paxos. Each run draws a random cluster size, set of
// proposers, and fault profile from its seed, runs a chaotic phase with
// faults, then a stable phase in which all nodes must eventually decide.
// Safety is checked on every message delivery; liveness at the end.
//
// Usage: Fuzz [-seed=N] [-runs=N] [-chaos=N] [-bound=N] [-bug=acceptor|round|adopt] [-v | -trace]
//   -v prints a message sequence diagram of each run; -trace prints a raw event log.
//   Run i uses seed (N + i); a failing run is reproduced with -seed=<its seed> -runs=1.

var seed = 1;
var runs = 1000;
var chaosRounds = 400;	// max rounds of the fault-injection phase
var bound = 3000;	// liveness bound: rounds after stabilization for all nodes to decide
var bug: string;
var verbose = false;	// print a message sequence diagram
var trace = false;	// print a raw event log

def main(args: Array<string>) -> int {
	for (a in args) {
		if (Strings.equal(a, "-v")) verbose = true;
		else if (Strings.equal(a, "-trace")) trace = verbose = true;
		else if (Strings.startsWith(a, "-seed=")) seed = intArg(a, 6);
		else if (Strings.startsWith(a, "-runs=")) runs = intArg(a, 6);
		else if (Strings.startsWith(a, "-chaos=")) chaosRounds = intArg(a, 7);
		else if (Strings.startsWith(a, "-bound=")) bound = intArg(a, 7);
		else if (Strings.startsWith(a, "-bug=")) bug = Arrays.range(a, 5, a.length);
		else return usage(a);
	}
	if (bug != null && !Strings.equal(bug, "acceptor") && !Strings.equal(bug, "round") && !Strings.equal(bug, "adopt")) {
		return usage(bug);
	}
	var safety = 0, liveness = 0, completed = 0, totalRounds = 0L, totalMsgs = 0L;
	for (i < runs) {
		var s = seed + i;
		var r = fuzzOne(s);
		completed++;
		totalRounds += r.rounds;
		totalMsgs += r.delivered;
		if (r.error == null) continue;
		if (r.isSafety) safety++;
		else liveness++;
		System.puts(StringBuilder.new()
			.put3("FAIL seed=%d: %s\n  config: %s\n", s, r.error, r.config)
			.put1("  reproduce: Fuzz -seed=%d -runs=1 -v", s)
			.puts(if(bug != null, " -bug=")).puts(if(bug != null, bug))
			.ln().toString());
		if (safety + liveness >= 10) {
			System.puts("stopping after 10 failures\n");
			break;
		}
	}
	System.puts(StringBuilder.new()
		.put3("%d runs, %d safety violations, %d liveness failures", completed, safety, liveness)
		.put2(" (%d rounds, %d messages delivered)", totalRounds, totalMsgs)
		.ln().toString());
	return if(safety + liveness > 0, 1, 0);
}

def usage(arg: string) -> int {
	System.puts(StringBuilder.new().put1("unknown argument: %s\n", arg).toString());
	System.puts("Usage: Fuzz [-seed=N] [-runs=N] [-chaos=N] [-bound=N] [-bug=acceptor|round|adopt] [-v | -trace]\n");
	return 2;
}

def intArg(a: string, start: int) -> int {
	var r = Ints.parseDecimal(a, start);
	if (r.0 <= 0 || start + r.0 != a.length) {
		System.error("FuzzError", StringBuilder.new().put1("invalid number in %s", a).toString());
	}
	return r.1;
}

class RunResult(error: string, isSafety: bool, config: string, rounds: int, delivered: int) { }

def fuzzOne(s: int) -> RunResult {
	var rng = Rng.new(u64.view(s));
	var n = rng.between(1, 7);
	var sim = Sim.new(n, rng.next());
	sim.listener = newListener();
	if (bug != null) {
		if (Strings.equal(bug, "acceptor")) sim.config.persistAcceptor = false;
		if (Strings.equal(bug, "round")) sim.config.persistRound = false;
		if (Strings.equal(bug, "adopt")) sim.config.adoptAccepted = false;
	}
	// Choose a random fault profile.
	var f = sim.faults;
	f.deliverPct = rng.between(5, 100);
	f.dropPct = if(rng.chance(70), rng.between(0, 50));
	f.dupPct = if(rng.chance(50), rng.between(0, 40));
	f.crashPct = if(rng.chance(60), rng.between(0, 10));
	f.restartPct = rng.between(1, 30);
	sim.timeoutMin = rng.between(1, 10);
	sim.timeoutMax = sim.timeoutMin + rng.between(0, 30);
	// Choose a random nonempty set of proposers, each with a distinct value.
	var numProposers = 0;
	for (i < n) {
		if (rng.chance(50)) {
			sim.propose(i, 100 + i);
			numProposers++;
		}
	}
	if (numProposers == 0) {
		var i = rng.range(n);
		sim.propose(i, 100 + i);
		numProposers++;
	}
	var chaos = rng.between(0, chaosRounds);
	var config = StringBuilder.new()
		.put3("nodes=%d proposers=%d chaos=%d ", n, numProposers, chaos)
		.put2("timeout=[%d,%d] ", sim.timeoutMin, sim.timeoutMax);
	f.render(config);
	var configStr = config.toString();
	if (verbose) System.puts(StringBuilder.new().put2("seed=%d: %s\n", s, configStr).toString());

	// Phase 1: chaos.
	for (r < chaos) {
		sim.step();
		if (sim.checker.violation != null) break;
	}
	// Phase 2: the network stabilizes; every node must eventually decide.
	if (sim.checker.violation == null) {
		sim.note("network stabilizes");
		f.dropPct = 0;
		f.dupPct = 0;
		f.crashPct = 0;
		if (f.deliverPct < 50) f.deliverPct = 50;
		// Retry timers must be long enough for a ballot to complete.
		if (sim.timeoutMin < 10) sim.timeoutMin = 10;
		if (sim.timeoutMax < sim.timeoutMin + 4 * n) sim.timeoutMax = sim.timeoutMin + 4 * n;
		sim.restartAll();
		for (r < bound) {
			if (sim.allDecided() || sim.checker.violation != null) break;
			sim.step();
		}
	}
	var error: string, isSafety = false;
	if (sim.checker.violation != null) {
		error = sim.checker.violation;
		isSafety = true;
	} else if (!sim.allDecided()) {
		error = StringBuilder.new().put2("liveness: only %d of %d nodes decided", sim.numDecided(), n)
			.put1(" within %d rounds of stabilizing", bound).toString();
	}
	if (verbose) {
		System.puts(StringBuilder.new()
			.put3("chosen=%d rounds=%d delivered=%d ", sim.checker.chosen, sim.round, sim.delivered)
			.put3("dropped=%d duplicated=%d crashes=%d\n", sim.dropped, sim.duplicated, sim.crashes)
			.toString());
	}
	return RunResult.new(error, isSafety, configStr, sim.round, sim.delivered);
}

def newListener() -> SimListener {
	if (trace) return TextLog.new();
	if (verbose) return Diagram.new();
	return SimListener.new();
}
